# NestJS Backend
PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=abhasetu

# Redis
REDIS_URL=redis://localhost:6379

# ABDM Sandbox (obtain from dev.abdm.gov.in)
ABDM_ENV=sandbox
ABDM_CM_ID=sbx
ABDM_CLIENT_ID=SBXID_038320
ABDM_CLIENT_SECRET=0c7fbf47-573a-4f7c-a26f-4188a9533133
ABDM_GATEWAY_BASE_URL_SANDBOX=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL_SANDBOX=https://abhasbx.abdm.gov.in/abha
ABDM_PHR_HID_BASE_URL_SANDBOX=https://healthidsbx.abdm.gov.in/api
ABDM_PHR_CM_BASE_URL_SANDBOX=https://dev.abdm.gov.in/cm
