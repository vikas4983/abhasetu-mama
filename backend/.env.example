# Public callback base URL (ngrok / Cloudflare tunnel for local dev)
ABDM_CALLBACK_BASE_URL=https://your-tunnel.example.com

# Set false in production to disable simulation fallbacks
ABDM_SIMULATION_MODE=true

# Pincode CSV import path (default: ../pincode_directory.csv from backend cwd)
PINCODE_CSV_PATH=../pincode_directory.csv

# Admin JWT
JWT_SECRET=change_me_in_production
